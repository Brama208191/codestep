{
  "uid": "codestep",
  "title": "codestep judge",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Submissions per minute",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(codestep_submissions_created_total[1m])) * 60", "legendFormat": "submissions/min" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Judge duration p50 / p95 (seconds)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum(rate(codestep_judge_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(codestep_judge_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue wait p95 (seconds) and waiting submissions",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(codestep_queue_wait_seconds_bucket[5m])) by (le))", "legendFormat": "wait p95" },
        { "refId": "B", "expr": "max(codestep_queue_waiting)", "legendFormat": "waiting" }
      ]
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Verdicts (last hour)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(codestep_judge_duration_seconds_count[1h])) by (verdict)", "legendFormat": "{{verdict}}" }]
    }
  ]
}
